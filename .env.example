# Secret HMAC utilisé pour hacher les flags (obligatoire en production).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changer ce secret invalide les flags déjà en base : relancer `npm run db:seed`.
FLAG_SECRET=

# Chemin du fichier SQLite (par défaut : data/ctf.db)
DATABASE_PATH=

# Base des liens « Lire » / « PDF » des cours (par défaut : /docs → dossier public/docs)
NEXT_PUBLIC_DOCS_BASE=/docs
